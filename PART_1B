###############################################################
# Feature Engineering
###############################################################

# Health Facilities per 100,000 Population
df["Facilities_per_100k"] = (
    df["Health_Facilities"] /
    df["Population"]
) * 100000

# Doctor Density Score
df["Doctor_Availability_Score"] = (
    df["Doctors_per_1000"] * 100
)

# Nurse Density Score
df["Nurse_Availability_Score"] = (
    df["Nurses_per_1000"] * 100
)

# Workforce Density
df["Healthcare_Workforce_Density"] = (
    df["Doctors_per_1000"] +
    df["Nurses_per_1000"]
)

# Service Coverage
df["Service_Coverage_Index"] = (

    df["Insurance_Coverage_pct"] +

    df["Immunization_Coverage_pct"] +

    df["Skilled_Birth_Attendance_pct"]

) / 3

# Infrastructure Index
df["Infrastructure_Index"] = (

    df["Improved_Water_Access_pct"] +

    df["Electricity_Availability_pct"]

) / 2

# Financial Protection
df["Financial_Protection_Index"] = (

    100 -

    df["Out_of_Pocket_Expenditure_pct"]

)

# Accessibility
df["Accessibility_Index"] = (

    120 -

    df["Avg_Travel_Time_to_Facility_min"]

)

###############################################################
# Risk Classification
###############################################################

df["Accessibility_Risk"] = np.where(

    df["Avg_Travel_Time_to_Facility_min"] > 60,

    "High",

    "Low"

)

df["Insurance_Level"] = pd.cut(

    df["Insurance_Coverage_pct"],

    bins=[0,20,40,60,80,100],

    labels=[

        "Very Low",

        "Low",

        "Moderate",

        "High",

        "Very High"

    ]

)

###############################################################
# Label Encoding
###############################################################

encoder = LabelEncoder()

df["Readiness_Label"] = encoder.fit_transform(
    df["Readiness_Category"]
)

###############################################################
# Average Readiness by State
###############################################################

state_summary = (

    df

    .groupby("State")

    .agg({

        "UHC_Readiness_Index":"mean",

        "Insurance_Coverage_pct":"mean",

        "Doctors_per_1000":"mean",

        "Nurses_per_1000":"mean",

        "Health_Facilities":"mean"

    })

    .round(2)

)

state_summary.to_csv(

    "outputs/reports/state_summary.csv"

)

###############################################################
# Top Performing States
###############################################################

top_states = (

