)

fig, ax = plt.subplots(

    figsize=(8,6)

)

disp.plot(

    ax=ax,

    cmap="Blues",

    xticks_rotation=45

)

plt.title(

    f"{best_classifier_name} Confusion Matrix"

)

plt.tight_layout()

plt.savefig(

    "outputs/figures/classification_confusion_matrix.png",

    dpi=300

)

plt.close()

