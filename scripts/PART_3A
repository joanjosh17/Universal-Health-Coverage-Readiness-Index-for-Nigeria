###############################################################
# PART 3A
# Hyperparameter Tuning (Classification)
###############################################################

from sklearn.model_selection import (
    StratifiedKFold,
    RandomizedSearchCV,
    cross_val_score
)

from xgboost import XGBClassifier
from scipy.stats import randint, uniform

###############################################################
# Cross Validation
###############################################################

cv = StratifiedKFold(

    n_splits=5,

    shuffle=True,

    random_state=42

)

###############################################################
# XGBoost Pipeline
###############################################################

xgb_pipeline = Pipeline(

    steps=[

        (

            "preprocessor",

            preprocessor

        ),

        (

            "classifier",

            XGBClassifier(

                objective="multi:softprob",

                num_class=len(label_encoder.classes_),

                eval_metric="mlogloss",

                tree_method="hist",

                random_state=42,

                n_jobs=-1

            )

        )

    ]

)

###############################################################
# Hyperparameter Space
###############################################################

parameter_space = {

    "classifier__n_estimators":

        randint(300,1000),

    "classifier__max_depth":

        randint(3,12),

    "classifier__learning_rate":

        uniform(0.01,0.25),

    "classifier__subsample":

        uniform(0.60,0.40),

    "classifier__colsample_bytree":

        uniform(0.60,0.40),

    "classifier__gamma":

        uniform(0,5),

    "classifier__min_child_weight":

        randint(1,10)

}

###############################################################
# Random Search
###############################################################

random_search = RandomizedSearchCV(

    estimator=xgb_pipeline,

    param_distributions=parameter_space,

    n_iter=30,

    scoring="accuracy",

    cv=cv,

    verbose=2,

    random_state=42,

    n_jobs=-1,

    refit=True

)

###############################################################
# Train
###############################################################

print("="*70)
print("Training Tuned XGBoost Classifier")
print("="*70)

random_search.fit(

    X_train,

    y_train_encoded

)

###############################################################
# Best Model
###############################################################

best_xgb = random_search.best_estimator_

print("\nBest Parameters")

print(random_search.best_params_)

print("\nBest CV Accuracy")

print(random_search.best_score_)

###############################################################
# Cross Validation
###############################################################

cv_scores = cross_val_score(

    best_xgb,

    X_train,

    y_train_encoded,

    cv=cv,

    scoring="accuracy",

    n_jobs=-1

)

cv_df = pd.DataFrame({

    "Fold":

        np.arange(1,6),

    "Accuracy":

        cv_scores

})

cv_df.to_csv(

    "outputs/reports/xgboost_cv_scores.csv",

    index=False

)

###############################################################
# Plot
###############################################################

plt.figure(figsize=(8,5))

plt.plot(

    cv_df["Fold"],

    cv_df["Accuracy"],

    marker="o"

)

plt.xlabel("Fold")

plt.ylabel("Accuracy")

plt.title("Cross Validation Accuracy")

plt.grid(True)

plt.tight_layout()

plt.savefig(

    "outputs/figures/xgboost_cv_scores.png",

    dpi=300

)

plt.close()

###############################################################
# Test Evaluation
###############################################################

predictions = best_xgb.predict(

    X_test

)

probabilities = best_xgb.predict_proba(

    X_test

)

accuracy = accuracy_score(

    y_test_encoded,

    predictions

)

precision = precision_score(

    y_test_encoded,

    predictions,

    average="weighted"

)

recall = recall_score(

    y_test_encoded,

    predictions,

    average="weighted"

)

f1 = f1_score(

    y_test_encoded,

    predictions,

    average="weighted"

)

print("\nAccuracy :", accuracy)

print("Precision:", precision)

print("Recall   :", recall)

print("F1 Score :", f1)

###############################################################
# Save Metrics
###############################################################

metrics = pd.DataFrame({

    "Metric":[

        "Accuracy",

        "Precision",

        "Recall",

        "F1 Score",

        "Cross Validation Accuracy"

    ],

    "Value":[

        accuracy,

        precision,

        recall,

        f1,

        random_search.best_score_

    ]

})

metrics.to_csv(

    "outputs/reports/tuned_xgboost_metrics.csv",

    index=False

)

###############################################################
# Save Model
###############################################################

joblib.dump(

    best_xgb,

    "models/final_xgboost_classifier.pkl"

)

###############################################################
# Confusion Matrix
###############################################################

cm = confusion_matrix(

    y_test_encoded,

    predictions

)

disp = ConfusionMatrixDisplay(

    confusion_matrix=cm,

    display_labels=label_encoder.classes_

)

fig, ax = plt.subplots(figsize=(8,6))

disp.plot(

    ax=ax,

    cmap="Blues",

    xticks_rotation=45

)

plt.tight_layout()

plt.savefig(

    "outputs/figures/final_xgboost_confusion_matrix.png",

    dpi=300

)

plt.close()

print("\nPART 3A COMPLETED SUCCESSFULLY")
