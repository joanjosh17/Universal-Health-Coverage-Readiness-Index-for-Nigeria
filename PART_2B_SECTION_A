###############################################################
# PART 2B
# SECTION A
# Regression Models for Predicting UHC Readiness Index
###############################################################

from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
from sklearn.impute import SimpleImputer
from sklearn.preprocessing import OneHotEncoder, StandardScaler

from sklearn.linear_model import LinearRegression

from sklearn.ensemble import (
    RandomForestRegressor,
    GradientBoostingRegressor,
    ExtraTreesRegressor
)

from sklearn.metrics import (
    mean_absolute_error,
    mean_squared_error,
    r2_score
)

###############################################################
# REMOVE TARGET LEAKAGE
###############################################################

print("="*70)
print("Removing Target Leakage")
print("="*70)

TARGET = "UHC_Readiness_Index"

DROP_COLUMNS = [

    "Record_ID",

    "Readiness_Category",

    "Readiness_Label",

    "UHC_Readiness_Index"

]

X_reg = df.drop(columns=DROP_COLUMNS)

y_reg = df[TARGET]

###############################################################
# Detect Feature Types
###############################################################

categorical_features_reg = X_reg.select_dtypes(

    include=["object","category"]

).columns.tolist()

numerical_features_reg = X_reg.select_dtypes(

    include=np.number

).columns.tolist()

###############################################################
# Train Test Split
###############################################################

X_train_reg, X_test_reg, y_train_reg, y_test_reg = train_test_split(

    X_reg,

    y_reg,

    test_size=0.20,

    random_state=42

)

###############################################################
# Preprocessing
###############################################################

numeric_transformer = Pipeline(

    steps=[

        (

            "imputer",

            SimpleImputer(strategy="median")

        ),

        (

            "scaler",

            StandardScaler()

        )

    ]

)

categorical_transformer = Pipeline(

    steps=[

        (

            "imputer",

            SimpleImputer(strategy="most_frequent")

        ),

        (

            "encoder",

            OneHotEncoder(

                handle_unknown="ignore"

            )

        )

    ]

)

preprocessor_reg = ColumnTransformer(

    transformers=[

        (

            "num",

            numeric_transformer,

            numerical_features_reg

        ),

        (

            "cat",

            categorical_transformer,

            categorical_features_reg

        )

    ]

)

###############################################################
# Regression Models
###############################################################

regression_models = {

    "Linear Regression":

        LinearRegression(),

    "Random Forest":

        RandomForestRegressor(

            n_estimators=400,

            random_state=42,

            n_jobs=-1

        ),

    "Gradient Boosting":

        GradientBoostingRegressor(

            random_state=42

        ),

    "Extra Trees":

        ExtraTreesRegressor(

            n_estimators=400,

            random_state=42,

            n_jobs=-1

        )

}

###############################################################
# Train Models
###############################################################

regression_results = []

trained_regressors = {}

for model_name, model in regression_models.items():

    print("="*70)
    print(model_name)
    print("="*70)

    pipeline = Pipeline(

        steps=[

            (

                "preprocessor",

                preprocessor_reg

            ),

            (

                "regressor",

                model

            )

        ]

    )

    pipeline.fit(

        X_train_reg,

        y_train_reg

    )

    predictions = pipeline.predict(

        X_test_reg

    )

    mae = mean_absolute_error(

        y_test_reg,

        predictions

    )

    mse = mean_squared_error(

        y_test_reg,

        predictions

    )

    rmse = np.sqrt(mse)

    r2 = r2_score(

        y_test_reg,

        predictions

    )

    regression_results.append({

        "Model":model_name,

        "MAE":mae,

        "RMSE":rmse,

        "R2 Score":r2

    })

    trained_regressors[model_name] = pipeline

###############################################################
# Results
###############################################################

regression_results = pd.DataFrame(

    regression_results

)

regression_results = regression_results.sort_values(

    by="R2 Score",

    ascending=False

)

print(regression_results)

regression_results.to_csv(

    "outputs/reports/regression_model_comparison.csv",

    index=False

)

###############################################################
# Best Regressor
###############################################################

best_regressor_name = regression_results.iloc[0]["Model"]

best_regressor = trained_regressors[

    best_regressor_name

]

print("\nBest Regression Model")

print(best_regressor_name)

###############################################################
# Save Model
###############################################################

import joblib

joblib.dump(

    best_regressor,

    "models/best_regression_model.pkl"

)

###############################################################
# Prediction Results
###############################################################

pred = best_regressor.predict(

    X_test_reg

)

prediction_df = X_test_reg.copy()

prediction_df["Actual_Index"] = y_test_reg.values

prediction_df["Predicted_Index"] = pred

prediction_df["Residual"] = (

    prediction_df["Actual_Index"]

    -

    prediction_df["Predicted_Index"]

)

prediction_df.to_csv(

    "outputs/reports/regression_predictions.csv",

    index=False

)

###############################################################
# Scatter Plot
###############################################################

plt.figure(figsize=(7,7))

plt.scatter(

    y_test_reg,

    pred,

    alpha=0.6

)

plt.plot(

    [

        y_test_reg.min(),

        y_test_reg.max()

    ],

    [

        y_test_reg.min(),

        y_test_reg.max()

    ],

    "r--"

)

plt.xlabel("Actual")

plt.ylabel("Predicted")

plt.title("Actual vs Predicted UHC Readiness Index")

plt.tight_layout()

plt.savefig(

    "outputs/figures/regression_actual_vs_predicted.png",

    dpi=300

)

plt.close()

###############################################################
# Residual Plot
###############################################################

residuals = y_test_reg - pred

plt.figure(figsize=(8,5))

plt.scatter(

    pred,

    residuals,

    alpha=0.6

)

plt.axhline(

    y=0,

    linestyle="--"

)

plt.xlabel("Predicted")

plt.ylabel("Residual")

plt.title("Residual Plot")

plt.tight_layout()

plt.savefig(

    "outputs/figures/regression_residual_plot.png",

    dpi=300

)

plt.close()

###############################################################
# Regression Feature Importance
###############################################################

if hasattr(

    best_regressor.named_steps["regressor"],

    "feature_importances_"

):

    feature_names = (

        best_regressor

        .named_steps["preprocessor"]

        .get_feature_names_out()

    )

    importance = (

        best_regressor

        .named_steps["regressor"]

        .feature_importances_

    )

    importance_df = pd.DataFrame({

        "Feature":feature_names,

        "Importance":importance

    })

    importance_df = importance_df.sort_values(

        by="Importance",

        ascending=False

    )

    importance_df.to_csv(

        "outputs/reports/regression_feature_importance.csv",

        index=False

    )

    plt.figure(figsize=(10,8))

    plt.barh(

        importance_df["Feature"][:20][::-1],

        importance_df["Importance"][:20][::-1]

    )

    plt.title("Top 20 Regression Features")

    plt.tight_layout()

    plt.savefig(

        "outputs/figures/regression_feature_importance.png",

        dpi=300

    )

    plt.close()

print("\nPART 2B - SECTION A COMPLETED SUCCESSFULLY")
